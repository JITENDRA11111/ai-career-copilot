# PRODUCTION ENVIRONMENT VARIABLES
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://mongo:27017/ai-career-copilot
REDIS_URL=redis://redis:6379
# Change this to your actual production domain
CLIENT_URL=https://your-domain.com

# JWT Secrets (MUST BE SECURE LONG STRINGS)
JWT_SECRET=generate_a_secure_random_string_here
JWT_REFRESH_SECRET=generate_another_secure_string_here

# OAuth
GOOGLE_CLIENT_ID=your_prod_client_id
GOOGLE_CLIENT_SECRET=your_prod_client_secret

# AI Keys
GEMINI_API_KEY=your_gemini_key

# External APIs
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
